# Cloudflare Pages 响应头（原 next.config.js headers 迁移）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/social-links.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/social-links.json
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
